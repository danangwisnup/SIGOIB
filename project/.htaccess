# Docroot = folder project/ (di cPanel: isi public_html atau docroot subdomain).
# Arahkan /api ke backend/api.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^api(/.*)?$ backend/api/index.php [L,QSA]
</IfModule>

# Lindungi folder backend selain api (tanpa leading slash: konteks .htaccess)
RedirectMatch 403 ^backend/(?!api/)
RedirectMatch 403 ^backend/\.env
